{
  "name": "@expo/rudder-sdk-node",
  "version": "2.0.0",
  "description": "Compact fork of rudder-node-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/expo/rudder-sdk-node.git"
  },
  "author": "Expo",
  "engines": {
    "node": ">=20"
  },
  "size-limit": [
    {
      "limit": "25 KB",
      "path": "index.js"
    }
  ],
  "scripts": {
    "dependencies": "yarn",
    "size": "size-limit",
    "watch": "tsc --watch",
    "build": "tsc",
    "prepare": "tsc",
    "test": "nyc --reporter=lcov --reporter=html --reporter=text ava --serial --verbose  > coverage.lcov",
    "lint": "eslint ."
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "cli.js",
    "index.d.ts",
    "index.js",
    "index.js.map"
  ],
  "keywords": [
    "analytics"
  ],
  "dependencies": {
    "@expo/bunyan": "^4.0.0",
    "@segment/loosely-validate-event": "^2.0.0",
    "fetch-retry": "^6.0.0",
    "md5": "^2.3.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@tsconfig/node20": "^20.1.5",
    "@types/jest": "^27.0.1",
    "@types/md5": "^2.3.1",
    "@types/node": "^20.14.1",
    "@types/uuid": "^8.3.1",
    "ava": "^0.25.0",
    "basic-auth": "^2.0.1",
    "body-parser": "^1.17.1",
    "commander": "^2.9.0",
    "delay": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "express": "^4.15.2",
    "fetch-mock": "^12.5.2",
    "jest": "^29.7.0",
    "nyc": "^14.1.1",
    "prettier": "^3.5.3",
    "sinon": "^7.3.2",
    "size-limit": "^1.3.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
